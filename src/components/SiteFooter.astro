---
import { nav, site, waLink } from '../data/site';
const social = Object.entries(site.social).filter(([, url]) => Boolean(url));
---

<footer class="site-footer">
  <div class="footer-brand-block">
    <a class="footer-mark" href="/" aria-label={`${site.name}, inicio`}>
      <img src="/images/brand/logo-machupicchu-beyond-white.jpg" alt="" width="481" height="423" loading="lazy" />
    </a>
    <div class="footer-copy">
      <p class="footer-name">MACHUPICCHU<br />BEYOND</p>
      <p class="footer-tag">LUXURY SPIRITUAL JOURNEYS</p>
    </div>
  </div>

  <nav class="footer-nav" aria-label="Navegación secundaria">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    <a href="/contacto">Concierge</a>
  </nav>

  <div class="footer-contact">
    <a href={waLink('Hola, quisiera información sobre las experiencias sagradas de Machupicchu Beyond.')} target="_blank" rel="noopener noreferrer">
      WhatsApp Concierge · {site.phoneDisplay}
    </a>
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <span>Base en {site.city}</span>
    {social.map(([name, url]) => (
      <a href={url} target="_blank" rel="noopener noreferrer">{name}</a>
    ))}
  </div>

  <p class="footer-note">
    Herencia andina viva. Ayni, reciprocidad y respeto por los Apus. Un viaje que transforma la mirada y honra el territorio.
  </p>

  <div class="footer-legal">
    <a href="/privacidad">Privacidad</a>
    <a href="/terminos">Términos del Servicio</a>
  </div>

  <a class="back-top" href="#main-content" aria-label="Volver al inicio del contenido">↑</a>
  <small class="copyright">© {new Date().getFullYear()} {site.name} · All rights reserved</small>
</footer>
