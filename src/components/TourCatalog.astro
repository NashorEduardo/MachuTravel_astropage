---
import { getLocaleFromUrl, useTranslations, type SupportedLocale } from '../i18n/utils';
import type { LocalizedTour } from '../i18n/content';

interface Props {
  tours: LocalizedTour[];
  showFilters?: boolean;
  lang?: SupportedLocale;
  activeCategory?: string;
}

const { tours, showFilters = false, lang, activeCategory = 'all' } = Astro.props;
const currentLocale = lang || getLocaleFromUrl(Astro.url);
const t = useTranslations(currentLocale);

function getKindLabel(kind: string) {
  switch (kind) {
    case 'trekking':
      return t.catalog.filterTreks;
    case 'ceremonia':
      return t.catalog.filterCeremonies;
    case 'peregrinacion':
      return t.catalog.filterPilgrimages;
    case 'iniciacion':
      return t.catalog.filterInitiation;
    default:
      return kind;
  }
}
---

<div class="tour-catalog-wrapper">
  {showFilters && (
    <div class="filters" aria-label="Filtrar por categoría">
      <button class:list={['filter-btn', activeCategory === 'all' ? 'is-active' : '']} type="button" data-filter="all">
        {t.catalog.filterAll}
      </button>
      <button class:list={['filter-btn', activeCategory === 'trekking' ? 'is-active' : '']} type="button" data-filter="trekking">
        {t.catalog.filterTreks}
      </button>
      <button class:list={['filter-btn', activeCategory === 'ceremonia' ? 'is-active' : '']} type="button" data-filter="ceremonia">
        {t.catalog.filterCeremonies}
      </button>
      <button class:list={['filter-btn', activeCategory === 'peregrinacion' ? 'is-active' : '']} type="button" data-filter="peregrinacion">
        {t.catalog.filterPilgrimages}
      </button>
      <button class:list={['filter-btn', activeCategory === 'iniciacion' ? 'is-active' : '']} type="button" data-filter="iniciacion">
        {t.catalog.filterInitiation}
      </button>
    </div>
  )}

  <div class="catalog-grid" id="catalog-cards-grid">
    {tours.map((tour) => {
      const kindLabel = getKindLabel(tour.data.kind);
      const difficulty = tour.data.difficulty || tour.data.level;
      const maxAltitude = tour.data.maxAltitude;
      const priceDisplay = tour.data.priceFrom || tour.data.price || t.catalog.consult;

      return (
        <article
          class="catalog-card glass-glow-card"
          data-kind={tour.data.kind}
          data-reveal
          data-tilt
        >
          <a
            class="catalog-card-anchor"
            href={`/${currentLocale}/rutas/${tour.slug}`}
            aria-label={`${t.catalog.exploreBtn}: ${tour.data.title}`}
          >
            <div class="catalog-media">
              {tour.data.image ? (
                <img
                  src={tour.data.image}
                  alt={tour.data.imageAlt || tour.data.title}
                  loading="lazy"
                  width="800"
                  height="520"
                />
              ) : (
                <div class="catalog-placeholder">M · B</div>
              )}
              <span class="catalog-badge">✦ {tour.data.tag}</span>
              <span class="catalog-days-badge">{tour.data.days}</span>
            </div>

            <div class="catalog-copy">
              <div class="catalog-meta">
                <span>{kindLabel}</span>
                <small>{tour.data.place}</small>
              </div>

              <h2>{tour.data.title}</h2>
              <p>{tour.data.summary}</p>

              <!-- Especificaciones técnicas rápidas -->
              <div class="catalog-specs-row">
                {maxAltitude && (
                  <span class="spec-chip" title={t.catalog.altitudeLabel}>
                    🏔️ {maxAltitude}
                  </span>
                )}
                {difficulty && (
                  <span class="spec-chip" title={t.catalog.difficultyLabel}>
                    ⚡ {difficulty}
                  </span>
                )}
                <span class="spec-chip spec-chip--price" title={t.catalog.fromPrice}>
                  💰 {priceDisplay}
                </span>
              </div>

              <div class="catalog-card-footer">
                <b>{t.catalog.exploreBtn}</b>
                <span aria-hidden="true">↗</span>
              </div>
            </div>
          </a>
        </article>
      );
    })}
  </div>
</div>

<style>
  .catalog-specs-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }
  .spec-chip {
    font-size: 11px;
    font-weight: 500;
    color: var(--andean);
    background: rgba(89, 103, 64, 0.08);
    padding: 4px 8px;
    border-radius: 6px;
    border: 1px solid rgba(89, 103, 64, 0.12);
    letter-spacing: 0.02em;
  }
  .spec-chip--price {
    background: rgba(255, 202, 2, 0.14);
    border-color: rgba(217, 167, 0, 0.25);
    color: #614a00;
    font-weight: 600;
  }
</style>

<script is:inline>
  (() => {
    const initCatalogFilter = () => {
      const filterBtns = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.catalog-card[data-kind]');
      if (!filterBtns.length || !cards.length) return;

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          filterBtns.forEach((b) => b.classList.remove('is-active'));
          btn.classList.add('is-active');

          const targetKind = btn.getAttribute('data-filter');

          cards.forEach((card) => {
            const cardKind = card.getAttribute('data-kind');
            if (targetKind === 'all' || cardKind === targetKind) {
              card.style.display = 'flex';
              setTimeout(() => {
                card.style.opacity = '1';
                card.style.transform = 'none';
              }, 20);
            } else {
              card.style.opacity = '0';
              card.style.transform = 'scale(0.96)';
              setTimeout(() => {
                card.style.display = 'none';
              }, 180);
            }
          });
        });
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCatalogFilter, { once: true });
    } else {
      initCatalogFilter();
    }
    document.addEventListener('astro:page-load', initCatalogFilter);
  })();
</script>
