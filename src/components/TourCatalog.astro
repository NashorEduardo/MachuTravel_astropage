---
interface TourItem {
  id: string;
  data: {
    title: string;
    subtitle?: string;
    tag: string;
    kind: string;
    place: string;
    days: string;
    price?: string;
    image?: string;
    imageAlt?: string;
    gallery?: string[];
    summary: string;
    group?: string;
    level?: string;
    referentialImage?: boolean;
  };
}

interface Props {
  tours: TourItem[];
  showFilters?: boolean;
}

const { tours, showFilters = false } = Astro.props;

// Categoría formateada con elegancia
function getKindLabel(kind: string) {
  switch (kind) {
    case 'iniciacion':
      return 'Iniciación Ancestral';
    case 'peregrinacion':
      return 'Peregrinación Sagrada';
    case 'ceremonia':
      return 'Ceremonia de Ayni';
    default:
      return kind;
  }
}

// Nivel de conexión mística
function getConnectionBadge(level?: string) {
  if (!level) return 'Conexión Consciente';
  if (level.toLowerCase().includes('exigente')) return 'Alta Montaña · Trascendencia';
  if (level.toLowerCase().includes('suave')) return 'Meditativo · Valles Cálidos';
  if (level.toLowerCase().includes('interior')) return 'Introspección Profunda';
  return 'Conexión Armónica';
}
---

<div class="tour-catalog-wrapper">
  {showFilters && (
    <div class="filters" aria-label="Filtrar por llamado espiritual">
      <button class="filter-btn is-active" type="button" data-filter="all">Todas las rutas</button>
      <button class="filter-btn" type="button" data-filter="ceremonia">Ceremonias</button>
      <button class="filter-btn" type="button" data-filter="peregrinacion">Peregrinaciones</button>
      <button class="filter-btn" type="button" data-filter="iniciacion">Iniciación</button>
    </div>
  )}

  <div class="catalog-grid" id="catalog-cards-grid">
    {tours.map((tour) => {
      const kindLabel = getKindLabel(tour.data.kind);
      const connectionLevel = getConnectionBadge(tour.data.level);

      return (
        <article
          class="catalog-card glass-glow-card"
          data-kind={tour.data.kind}
          data-reveal
          data-tilt
        >
          <a class="catalog-card-anchor" href={`/rutas/${tour.id}`} aria-label={`Ver detalles de ${tour.data.title}`}>
            <div class="catalog-media">
              {tour.data.image ? (
                <img
                  src={tour.data.image}
                  alt={tour.data.imageAlt || tour.data.title}
                  loading="lazy"
                  width="800"
                  height="520"
                />
              ) : (
                <div class="catalog-placeholder">M · B</div>
              )}
              <span class="catalog-badge">✦ {tour.data.tag}</span>
              <span class="catalog-days-badge">{tour.data.days}</span>
            </div>

            <div class="catalog-copy">
              <div class="catalog-meta">
                <span>{kindLabel}</span>
                <small>{tour.data.place}</small>
              </div>

              <h2>{tour.data.title}</h2>
              <p>{tour.data.summary}</p>

              <!-- Indicador de conexión espiritual -->
              <div style="font-size: 10px; color: var(--machu-deep); background: rgba(89, 103, 64, 0.08); padding: 6px 10px; border-radius: 6px; margin-bottom: 16px; font-weight: 500; letter-spacing: 0.04em;">
                ⚡ {connectionLevel}
              </div>

              <div class="catalog-card-footer">
                <b>Explorar experiencia</b>
                <span aria-hidden="true">↗</span>
              </div>
            </div>
          </a>
        </article>
      );
    })}
  </div>
</div>

<script is:inline>
  (() => {
    const initCatalogFilter = () => {
      const filterBtns = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.catalog-card[data-kind]');
      if (!filterBtns.length || !cards.length) return;

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          filterBtns.forEach((b) => b.classList.remove('is-active'));
          btn.classList.add('is-active');

          const targetKind = btn.getAttribute('data-filter');

          cards.forEach((card) => {
            const cardKind = card.getAttribute('data-kind');
            if (targetKind === 'all' || cardKind === targetKind) {
              card.style.display = 'flex';
              setTimeout(() => {
                card.style.opacity = '1';
                card.style.transform = 'none';
              }, 30);
            } else {
              card.style.opacity = '0';
              card.style.transform = 'scale(0.96)';
              setTimeout(() => {
                card.style.display = 'none';
              }, 200);
            }
          });
        });
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCatalogFilter, { once: true });
    } else {
      initCatalogFilter();
    }
    document.addEventListener('astro:page-load', initCatalogFilter);
  })();
</script>
