---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { absoluteUrl, site } from '../data/site';
import { getLocaleFromUrl, getAlternateLinks, type SupportedLocale, DEFAULT_LOCALE } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  lang?: SupportedLocale;
}

const {
  title,
  description,
  image = site.defaultImage,
  type = 'website',
  noindex = false,
  schema,
  lang,
} = Astro.props;

const currentLocale = lang || getLocaleFromUrl(Astro.url);
const pageTitle = title || `${site.name} — ${site.tagline[currentLocale] || site.tagline.es}`;
const pageDesc = description || (site.description[currentLocale] || site.description.es);
const canonical = absoluteUrl(Astro.url.pathname);
const socialImage = absoluteUrl(image);
const { alternates, xDefault } = getAlternateLinks(Astro.url.pathname, site.url);

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.url,
    inLanguage: currentLocale,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'TravelAgency',
    name: site.name,
    legalName: site.legalName,
    taxID: site.ruc,
    url: site.url,
    description: pageDesc,
    email: site.email,
    telephone: site.phoneDisplay,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address,
      addressLocality: 'Cusco',
      addressRegion: 'Cusco',
      addressCountry: 'PE',
    },
    areaServed: ['Cusco', 'Perú', 'Andes'],
    knowsAbout: [
      'High-mountain trekking in Peru',
      'Salkantay Trek',
      'Inca Trail',
      'Ausangate Circuit',
      'Pachamama Ceremonies',
      'Indigenous Andean Culture',
    ],
  },
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
];
---
<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e0f0a" />
    <meta name="description" content={pageDesc} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />
    <link rel="canonical" href={canonical} />

    <!-- Alternates para indexación multilingüe SEO -->
    {alternates.map((item) => (
      <link rel="alternate" hreflang={item.locale} href={item.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <!-- Open Graph -->
    <meta property="og:locale" content={currentLocale === 'es' ? 'es_PE' : currentLocale === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={`${site.name} — ${pageTitle}`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={socialImage} />

    <title>{pageTitle}</title>

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800&family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400&display=swap" rel="stylesheet" />
    <ClientRouter />

    {schemas.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body>
    <!-- Film Grain & Ambient Aurora -->
    <div class="film-grain" aria-hidden="true"></div>
    <div class="ambient-aurora" aria-hidden="true"></div>

    <a class="skip-link" href="#main-content">
      {currentLocale === 'en' ? 'Skip to content' : currentLocale === 'pt' ? 'Pular para o conteúdo' : 'Saltar al contenido'}
    </a>

    <slot />

    <script is:inline>
      (() => {
        const initInteractive = () => {
          // Scroll reveal con IntersectionObserver
          const revealItems = document.querySelectorAll('[data-reveal]');
          if ('IntersectionObserver' in window && revealItems.length) {
            const observer = new IntersectionObserver((entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  observer.unobserve(entry.target);
                }
              });
            }, { threshold: 0.12, rootMargin: '0px 0px -30px 0px' });
            revealItems.forEach((item) => observer.observe(item));
          } else {
            revealItems.forEach((item) => item.classList.add('is-visible'));
          }

          // Tilt 3D sutil respetando prefers-reduced-motion
          const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!prefersReduced) {
            document.querySelectorAll('[data-tilt]').forEach((card) => {
              const el = card;
              el.addEventListener('mousemove', (event) => {
                if (window.innerWidth < 900) return;
                const rect = el.getBoundingClientRect();
                const x = event.clientX - rect.left;
                const y = event.clientY - rect.top;
                const rotateX = ((y / rect.height) - 0.5) * -6;
                const rotateY = ((x / rect.width) - 0.5) * 6;
                el.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-3px)`;
              });
              el.addEventListener('mouseleave', () => {
                el.style.transform = '';
              });
            });

            document.querySelectorAll('.glass-glow-card').forEach((card) => {
              card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                card.style.setProperty('--mouse-x', `${x}px`);
                card.style.setProperty('--mouse-y', `${y}px`);
              });
            });
          }
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initInteractive, { once: true });
        } else {
          initInteractive();
        }
        document.addEventListener('astro:page-load', initInteractive);
      })();
    </script>
  </body>
</html>
