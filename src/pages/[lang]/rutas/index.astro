---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import TourCatalog from '../../../components/TourCatalog.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { SUPPORTED_LOCALES, useTranslations, type SupportedLocale } from '../../../i18n/utils';
import { getToursByLocale } from '../../../i18n/content';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const t = useTranslations(lang);
const tours = await getToursByLocale(lang);
---

<BaseLayout
  lang={lang}
  title={`${t.nav.routes} | Machupicchu Beyond`}
  description={t.catalog.title + ' — ' + t.axes.lead}
>
  <SiteHeader lang={lang} />

  <main id="main-content">
    <section class="page-hero">
      <div class="breadcrumb-wrap" style="padding: 0; margin-bottom: 24px;">
        <Breadcrumbs
          items={[
            { label: t.nav.home, href: `/${lang}/` },
            { label: t.nav.routes },
          ]}
        />
      </div>
      <p class="section-label">
        <span>✦</span> CUSCO · TREKKING · MÍSTICA · IMPACTO SOCIAL
      </p>
      <h1>
        {t.catalog.title}<br />
        <em>{t.catalog.titleEm}</em>
      </h1>
      <p>
        {t.axes.lead} Selecciona el sendero que resuene con el momento de tu vida, desde trekkings de alta montaña hasta ceremonias sagradas y convivencias comunitarias.
      </p>
    </section>

    <section class="catalog section-wrap" style="padding-bottom: 90px;">
      <TourCatalog tours={tours} showFilters={true} lang={lang} activeCategory="all" />
    </section>
  </main>

  <SiteFooter lang={lang} />
</BaseLayout>
