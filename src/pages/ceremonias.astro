---
import BaseLayout from '../layouts/BaseLayout.astro'; import SiteHeader from '../components/SiteHeader.astro'; import SiteFooter from '../components/SiteFooter.astro'; import { getCollection } from 'astro:content';
const tours = (await getCollection('tours')).filter((t) => t.data.kind === 'ceremonia' || t.data.kind === 'iniciacion');
---
<BaseLayout title="Ceremonias y encuentros | Machupicchu Beyond"><SiteHeader /><main><section class="page-hero"><p class="section-label">CULTURA · ENCUENTRO · RESPETO</p><h1>Acercarse con<br /><em>presencia.</em></h1><p>Experiencias culturales acompañadas por facilitadores locales. Cada encuentro se realiza desde el respeto por su origen y por quienes lo conducen.</p></section><section class="section-wrap values"><div class="section-heading"><h2>El rito pertenece<br />a quien lo <em>guía.</em></h2><p class="section-lead">Nos ocupamos de coordinar el viaje y facilitar información clara antes de partir. La participación es personal y siempre voluntaria.</p></div><div class="catalog-grid">{tours.map((tour) => <a class="catalog-card" href={`/rutas/${tour.id}`}>{tour.data.image && <img src={tour.data.image} alt={tour.data.imageAlt || tour.data.title} loading="lazy" width="1200" height="800" />}<div class="catalog-copy"><span>{tour.data.kind}</span><h2>{tour.data.title}</h2><p>{tour.data.summary}</p><b>Conocer ruta ↗</b></div></a>)}</div></section></main><SiteFooter /></BaseLayout>
