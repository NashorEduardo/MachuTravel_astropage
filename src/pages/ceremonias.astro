---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TourCatalog from '../components/TourCatalog.astro';
import EnergyPillars from '../components/EnergyPillars.astro';
import { waLink } from '../data/site';

const ceremonialTours = (await getCollection('tours'))
  .filter((t) => t.data.kind === 'ceremonia' || t.data.kind === 'iniciacion')
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Ceremonias Sagradas y Ritos Andinos en Cusco | Machupicchu Beyond"
  description="Conoce el Despacho a la Pachamama, ritos de paso Karpay con maestros Q'ero y retiros de sanación en Cusco con Machupicchu Beyond."
>
  <SiteHeader />

  <main id="main-content">
    <section class="page-hero">
      <div class="breadcrumb-wrap" style="padding: 0; margin-bottom: 24px;">
        <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Ceremonias y Encuentros' }]} />
      </div>
      <p class="section-label">
        <span>✦</span> CULTURA VIVA · ENCUENTRO · RECIPROCIDAD
      </p>
      <h1>
        Acercarse con<br />
        <em>presencia y reverencia.</em>
      </h1>
      <p>
        El rito no es una representación teatral ni un espectáculo para forasteros. En Machupicchu Beyond facilitamos encuentros sagrados conducidos por maestros y maestras locales desde el respeto a su sabiduría ancestral.
      </p>
    </section>

    <!-- COMPONENTE WOW: ENERGY PILLARS -->
    <EnergyPillars
      title="Pilares del Rito y la Energía Andina"
      subtitle="LA ENSEÑANZA TRAS CADA OFRENDA"
    />

    <!-- CATÁLOGO DE EXPERIENCIAS CEREMONIALES -->
    <section class="section-wrap" style="padding-block: 80px 100px;">
      <div class="section-heading" data-reveal>
        <div>
          <div class="section-label"><span>✦</span> EXPERIENCIAS DE ENCUENTRO</div>
          <h2>Ceremonias e <em>iniciaciones.</em></h2>
        </div>
        <p class="section-lead">
          Desde una ofrenda de un día en el Valle Sagrado hasta retiros de inmersión y viajes de sabiduría hacia las alturas Q'ero.
        </p>
      </div>

      <div style="margin-top: 40px;">
        <TourCatalog tours={ceremonialTours} />
      </div>
    </section>

    <!-- ÉTICA DEL AYNI -->
    <section class="values section-wrap" data-reveal style="border-top: 1px solid #dedbce;">
      <div class="section-heading">
        <div>
          <div class="section-label"><span>✦</span> NUESTRO COMPROMISO</div>
          <h2>La reciprocidad sagrada<br />del <em>Ayni.</em></h2>
        </div>
        <p class="section-lead">
          La agencia coordina la logística impecable del viaje; el rito y la conducción sagrada pertenecen exclusivamente a quien lo guía.
        </p>
      </div>
      <div class="value-grid">
        <article data-tilt>
          <span>01 / AUTORIDAD</span>
          <h3>Maestros Locales</h3>
          <p>Cada ceremonia es celebrada por paqos, altomisayoc o curanderos reconocidos por sus propias comunidades.</p>
        </article>
        <article data-tilt>
          <span>02 / LIBERTAD</span>
          <h3>Participación Voluntaria</h3>
          <p>No hay imposiciones. Cada viajero participa en los gestos que sienta afines a su fe y permanece en silencio cuando lo desee.</p>
        </article>
        <article data-tilt>
          <span>03 / INTEGRACIÓN</span>
          <h3>Espacio de Asimilación</h3>
          <p>No terminamos un rito para correr al siguiente destino. Damos tiempo para descansar, dialogar y anclar lo vivido.</p>
        </article>
      </div>
    </section>

    <!-- CIERRE DE CONVERSIÓN CONCIERGE -->
    <div class="section-wrap" style="padding-bottom: 100px;">
      <section class="tour-cta-band" data-reveal>
        <div>
          <p class="section-label section-label--light"><span>✦</span> ORIENTACIÓN CONCIERGE</p>
          <h2>¿Tienes preguntas sobre<br /><em>las ceremonias andinas?</em></h2>
          <p>
            Conversa directamente con nosotros para resolver cualquier inquietud sobre preparación previa, hoja de coca, dietas o propósito del viaje.
          </p>
        </div>
        <a class="button button--gold" href={waLink('Hola, quisiera orientación personalizada sobre las ceremonias andinas y el despacho a la Pachamama.')} target="_blank" rel="noopener noreferrer">
          Hablar con un Guía Espiritual <span>💬</span>
        </a>
      </section>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
