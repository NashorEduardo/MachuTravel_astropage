---
import BaseLayout from '../layouts/BaseLayout.astro'; import SiteHeader from '../components/SiteHeader.astro'; import SiteFooter from '../components/SiteFooter.astro'; import { site, waLink } from '../data/site';
---
<BaseLayout title="Contacto | Machupicchu Beyond"><SiteHeader /><main id="main-content"><section class="contact-page"><div><p class="section-label section-label--light">CONVERSEMOS</p><h1>El viaje empieza<br />con una <em>pregunta.</em></h1><p>Cuéntanos qué ruta te interesa y cuándo te gustaría viajar. Te responderemos con los siguientes pasos.</p><a class="contact-direct" href={waLink('Hola, quisiera información sobre los viajes de Machupicchu Beyond.')}>WhatsApp · {site.phoneDisplay} ↗</a><a class="contact-direct" href={`mailto:${site.email}`}>{site.email} ↗</a><p>{site.city}</p></div><form class="contact-form" id="contact-form" data-wa={`https://wa.me/${site.whatsapp}`} ><label>Tu nombre<input name="nombre" required autocomplete="name" /></label><label>Correo electrónico<input name="correo" type="email" required autocomplete="email" /></label><label>¿Qué experiencia te interesa?<select name="ruta"><option>Quiero orientación</option><option>Despertar Solar en Machu Picchu</option><option>Una ceremonia andina</option><option>Una peregrinación</option></select></label><label>Mensaje<textarea name="mensaje" rows="4" placeholder="Fechas aproximadas, número de viajeros…"></textarea></label><button class="button button--gold" type="submit">Preparar mensaje en WhatsApp ↗</button><small>El mensaje se abrirá en WhatsApp para que lo revises y lo envíes.</small></form></section></main><SiteFooter /><script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  form?.addEventListener('submit', (event) => { event.preventDefault(); const data = new FormData(form); const message = `Hola, soy ${data.get('nombre')}. Mi correo es ${data.get('correo')}. Me interesa: ${data.get('ruta')}. ${data.get('mensaje') || ''}`; window.open(`${form.dataset.wa}?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer'); });
</script></BaseLayout>
