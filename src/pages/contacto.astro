---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site, waLink } from '../data/site';
---

<BaseLayout
  title="Concierge Espiritual & Reservas | Machupicchu Beyond"
  description="Inicia tu viaje sagrado a Cusco y los Andes. Habla con un guía espiritual o solicita la apertura de tu ceremonia con atención concierge personalizada."
>
  <SiteHeader />

  <main id="main-content">
    <div class="breadcrumb-wrap" style="background: var(--machu-deep); border-bottom: 1px solid rgba(255,255,255,0.08);">
      <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Concierge & Contacto' }]} />
    </div>

    <section class="contact-page">
      <div>
        <p class="section-label section-label--light">
          <span>✦</span> ATENCIÓN CONCIERGE PERSONALIZADA
        </p>
        <h1>
          El viaje sagrado empieza<br />
          con una <em>conversación.</em>
        </h1>
        <p>
          No vendemos paquetes masivos ni itinerarios rígidos. Cada experiencia se teje a la medida del propósito de tu espíritu, tus tiempos y tu energía.
        </p>

        <div class="concierge-perks">
          <div class="concierge-perk">
            <span>✦</span>
            <span>Respuesta personal y confidencial en menos de 12 horas</span>
          </div>
          <div class="concierge-perk">
            <span>✦</span>
            <span>Coordinación directa desde nuestra base en Cusco</span>
          </div>
          <div class="concierge-perk">
            <span>✦</span>
            <span>Entrevista previa para sintonizar la intención y salud</span>
          </div>
        </div>

        <div class="contact-direct-wrap">
          <a class="contact-direct" href={waLink('Hola, deseo coordinar una consulta espiritual con Machupicchu Beyond.')} target="_blank" rel="noopener noreferrer">
            <span style="color: var(--inti);">💬</span> WhatsApp Directo: {site.phoneDisplay} ↗
          </a>
          <a class="contact-direct" href={`mailto:${site.email}`}>
            <span style="color: var(--inti);">✉️</span> Correo Concierge: {site.email} ↗
          </a>
          <p style="color: rgba(255,255,255,0.6); font-size: 12px; margin-top: 8px;">
            Base operativa: {site.city}
          </p>
        </div>
      </div>

      <!-- FORMULARIO CONCIERGE -->
      <form class="contact-form" id="contact-form" data-wa={`https://wa.me/${site.whatsapp}`}>
        <h3>Solicitar Apertura de Ceremonia</h3>
        <p style="margin: 0; font-size: 12px; color: #6e6b60; line-height: 1.6;">
          Completa este breve formulario y nuestro equipo concierge preparará tu propuesta o coordinará una llamada con un guía.
        </p>

        <label>
          Tu Nombre Completo
          <input name="nombre" required autocomplete="name" placeholder="Ej. Valeria Mendoza" />
        </label>

        <label>
          Correo Electrónico
          <input name="correo" type="email" required autocomplete="email" placeholder="valeria@ejemplo.com" />
        </label>

        <label>
          Número de WhatsApp (con código de país)
          <input name="telefono" type="tel" placeholder="+51 987 654 321" />
        </label>

        <label>
          Experiencia o Ruta de Interés
          <select name="ruta" id="ruta-select">
            <option value="Quiero orientación personalizada">Orientación personalizada / Elegir según mi momento</option>
            <option value="Despertar Solar en Machu Picchu">Despertar Solar en Machu Picchu (2 días)</option>
            <option value="Despacho a la Pachamama">Despacho a la Pachamama (Valle Sagrado, Día completo)</option>
            <option value="Retiro en la Ceja de Selva">Retiro en la Ceja de Selva (4 días / 3 noches)</option>
            <option value="Camino de sabiduría Q'ero">Camino de sabiduría Q'ero (Iniciación, 5 días)</option>
            <option value="Peregrinación al Ausangate">Peregrinación al Ausangate (Montaña sagrada, 6 días)</option>
            <option value="Santuario de Waqrapukara">Santuario de Waqrapukara (2 días / 1 noche)</option>
          </select>
        </label>

        <label>
          ¿Cuál es el anhelo o intención de tu viaje?
          <textarea
            name="mensaje"
            rows="3"
            placeholder="Fechas aproximadas, si viajas solo/a o en pareja, tu estado actual..."
          ></textarea>
        </label>

        <button class="button button--gold" type="submit" style="width: 100%;">
          Hablar con un Guía Espiritual por WhatsApp <span>💬</span>
        </button>

        <small>
          Al presionar, se abrirá WhatsApp con los datos organizados para iniciar tu conversación de inmediato con nuestro concierge en Cusco.
        </small>
      </form>
    </section>
  </main>

  <SiteFooter />

  <script is:inline>
    (() => {
      const initContact = () => {
        // Pre-seleccionar ruta si viene por query param (?ruta=...)
        const params = new URLSearchParams(window.location.search);
        const rutaParam = params.get('ruta');
        const selectEl = document.getElementById('ruta-select');
        if (rutaParam && selectEl) {
          for (let i = 0; i < selectEl.options.length; i++) {
            if (selectEl.options[i].text.toLowerCase().includes(rutaParam.toLowerCase()) ||
                selectEl.options[i].value.toLowerCase().includes(rutaParam.toLowerCase())) {
              selectEl.selectedIndex = i;
              break;
            }
          }
        }

        const form = document.querySelector('#contact-form');
        form?.addEventListener('submit', (event) => {
          event.preventDefault();
          const formData = new FormData(form);
          const nombre = formData.get('nombre') || '';
          const correo = formData.get('correo') || '';
          const tel = formData.get('telefono') || '';
          const ruta = formData.get('ruta') || '';
          const mensaje = formData.get('mensaje') || '';

          const text = `Hola Machupicchu Beyond. Soy ${nombre} (${correo}${tel ? ', Tel: ' + tel : ''}). Deseo solicitar información sobre la experiencia: "${ruta}". Mensaje o intención: "${mensaje}".`;
          const waUrl = `${form.dataset.wa}?text=${encodeURIComponent(text)}`;
          window.open(waUrl, '_blank', 'noopener,noreferrer');
        });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initContact, { once: true });
      } else {
        initContact();
      }
      document.addEventListener('astro:page-load', initContact);
    })();
  </script>
</BaseLayout>
