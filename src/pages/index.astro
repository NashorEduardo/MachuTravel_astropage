---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import EnergyPillars from '../components/EnergyPillars.astro';
import SpiritualQuiz from '../components/SpiritualQuiz.astro';
import { site, siteFaq, trustPoints, testimonials, waLink, featuredNumbers, reusedJourneyImages } from '../data/site';

const tours = (await getCollection('tours')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const imageLoop = [...reusedJourneyImages, ...reusedJourneyImages];
const commentsLoop = [...testimonials, ...testimonials];

const intents = [
  {
    id: 'sanacion',
    label: 'Sanación Interior',
    icon: '🌱',
    tour: 'Despacho a la Pachamama',
    slug: 'despacho-pachamama',
    desc: 'Ofrenda ceremonial de armonización y siembra de intenciones en el Valle Sagrado.',
  },
  {
    id: 'apus',
    label: 'Conexión con Apus',
    icon: '🏔️',
    tour: 'Peregrinación al Ausangate',
    slug: 'peregrinacion-ausangate',
    desc: 'Travesía sagrada entre glaciares y lagunas turquesas a los pies del gran Apu protector.',
  },
  {
    id: 'iniciacion',
    label: 'Iniciación Ancestral',
    icon: '📜',
    tour: 'Camino de sabiduría Q\'ero',
    slug: 'camino-qero',
    desc: 'Convivencia en las comunidades altas y ritos de paso Karpay con maestros Paqos de linaje puro.',
  },
  {
    id: 'selva',
    label: 'Retiro en Selva',
    icon: '🍃',
    tour: 'Retiro en la Ceja de Selva',
    slug: 'retiro-ceja-de-selva',
    desc: 'Inmersión en albergue apartado, medicina tradicional y círculos de integración.',
  },
  {
    id: 'solar',
    label: 'Despertar Solar',
    icon: '☀️',
    tour: 'Despertar Solar en Machu Picchu',
    slug: 'despertar-solar',
    desc: 'Recepción consciente del primer rayo del Inti sobre las terrazas milenarias.',
  },
];
---

<BaseLayout
  title="Machupicchu Beyond | Luxury Spiritual & Sacred Andean Journeys"
  description="Viajes iniciáticos, peregrinaciones sagradas y ceremonias ancestrales en Cusco y los Andes. Grupos reducidos de 4 a 8 personas acompañados por maestros locales."
>
  <SiteHeader />

  <main id="main-content">
    <!-- HERO CINEMATOGRÁFICO MÍSTICO -->
    <section class="hero hero--immersive" aria-labelledby="hero-title">
      <div class="hero-backdrop-container">
        <img
          class="hero-backdrop"
          src="/images/journeys/machu-picchu-mist.jpg"
          alt="Machu Picchu místico cubierto por la neblina sagrada de los Andes"
          width="2200"
          height="1467"
          fetchpriority="high"
        />
      </div>
      
      <div class="hero-overlay"></div>
      <div class="hero-mist-mask" aria-hidden="true"></div>

      <div class="hero-inner">
        <!-- Emblema Sagrado con respiración sutil -->
        <div class="hero-brand-symbol">
          <div class="symbol-halo" aria-hidden="true">
            <img src="/images/brand/simbolo-machupicchu-beyond.jpg" alt="Símbolo Sagrado Machupicchu Beyond" width="44" height="44" />
          </div>
          <p class="eyebrow">
            CUSCO · PERÚ <span class="eyebrow-line"></span> LUXURY SPIRITUAL JOURNEYS
          </p>
        </div>

        <h1 id="hero-title">
          El camino<br />
          te lleva <em>más allá.</em>
        </h1>
        
        <p class="hero-description">
          Santuarios remotos, peregrinaciones de montaña y ceremonias vivas en grupos íntimos de 4 a 8 viajeros. Una experiencia de transformación guiada por la sabiduría del territorio andino.
        </p>

        <div class="hero-actions">
          <a class="button button--gold" href="/rutas">
            Explorar las rutas <span>↗</span>
          </a>
          <a class="button button--dark" href="#oraculo-andino">
            Consultar el Oráculo <span>✦</span>
          </a>
          <a class="hero-secondary" href="/nosotros">
            Nuestra cosmovisión
          </a>
        </div>

        <!-- WIDGET FLOTANTE: BUSCADOR POR INTENCIÓN ESPIRITUAL -->
        <div class="spiritual-intent-widget" data-reveal>
          <div class="intent-widget-header">
            <span class="intent-widget-label">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
              ¿Cuál es tu intención espiritual?
            </span>
            <span class="intent-widget-hint">Selecciona tu llamado:</span>
          </div>

          <div class="intent-pills">
            {intents.map((item, idx) => (
              <button
                class:list={["intent-pill", idx === 0 ? "is-selected" : ""]}
                type="button"
                data-intent-id={item.id}
                data-tour-title={item.tour}
                data-tour-slug={item.slug}
                data-tour-desc={item.desc}
              >
                <span>{item.icon}</span> {item.label}
              </button>
            ))}
          </div>

          <!-- Previsualización reactiva de la intención -->
          <div class="intent-preview-card is-active" id="intent-preview-box">
            <div class="intent-preview-text">
              <b id="preview-tour-title">{intents[0].tour}</b>
              <span id="preview-tour-desc">{intents[0].desc}</span>
            </div>
            <a class="intent-preview-link" id="preview-tour-link" href={`/rutas/${intents[0].slug}`}>
              Ver experiencia <span>↗</span>
            </a>
          </div>
        </div>

        <div class="hero-floaters" aria-hidden="true">
          <article class="floating-note" data-tilt>
            <span>06 EXPERIENCIAS SACRAS</span>
            <b>Rutas Activas</b>
            <p>Peregrinaciones, ritos de paso y retiros guiados por maestros locales.</p>
          </article>
          <article class="floating-note floating-note--gold" data-tilt>
            <span>GRUPOS ÍNTIMOS</span>
            <b>4 a 8 viajeros</b>
            <p>Espacio reverencial para el silencio, la escucha y el respeto mutuo.</p>
          </article>
        </div>
      </div>

      <p class="hero-caption">
        MACHU PICCHU · SANTUARIO HISTÓRICO <span>FOTOGRAFÍA: GERRY SHEA</span>
      </p>
      <span class="hero-index">01 / 06</span>
    </section>

    <!-- MARQUEE SAGRADO -->
    <div class="marquee" aria-hidden="true">
      <span>TIERRA · MEMORIA · AYNI · APUS SAGRADOS · DESPACHO · INTI RAYMI · KAWSAY · SILENCIO ANDINO · TIERRA · MEMORIA · AYNI ·</span>
    </div>

    <!-- BANDA DE INDICADORES CLAVE -->
    <section class="section-wrap numbers-band" data-reveal>
      {featuredNumbers.map((item) => (
        <article data-tilt>
          <b>{item.value}</b>
          <span>{item.label}</span>
        </article>
      ))}
    </section>

    <!-- INTRODUCCIÓN EDITORIAL -->
    <section class="intro section-wrap" id="esencia" data-reveal>
      <div class="section-label"><span>01</span> UNA INVITACIÓN AL ENCUENTRO</div>
      <div class="intro-grid">
        <h2>
          No venimos solo a mirar.<br />
          <em>Venimos a transformarnos.</em>
        </h2>
        <div>
          <p>
            Desde Cusco, concebimos el viaje como un umbral sagrado. No consumimos la cultura como si fuese un decorado: nos integramos con humildad, caminamos en silencio y dejamos que la memoria milenaria de los Andes nos recuerde quiénes somos.
          </p>
          <a class="under-link" href="/nosotros">Nuestra mirada sagrada <span>↗</span></a>
        </div>
      </div>
    </section>

    <!-- COMPONENTE WOW: ENERGY PILLARS (COSMOVISIÓN SAGRADA) -->
    <EnergyPillars />

    <!-- CATÁLOGO DESTACADO DE RUTAS -->
    <section class="journeys section-wrap" id="rutas">
      <div class="section-heading" data-reveal>
        <div>
          <div class="section-label"><span>02</span> RUTAS DE TRASCENDENCIA</div>
          <h2>Elige tu <em>camino.</em></h2>
        </div>
        <a class="under-link" href="/rutas">Ver todas las rutas <span>↗</span></a>
      </div>
      <div class="journey-grid journey-grid--dynamic">
        {tours.slice(0, 4).map((tour, i) => (
          <a class:list={["journey-card", `journey-card--${i + 1}`]} href={`/rutas/${tour.id}`} data-reveal data-tilt>
            {tour.data.image && (
              <img
                src={tour.data.image}
                alt={tour.data.imageAlt || tour.data.title}
                loading="lazy"
                width="1200"
                height="800"
              />
            )}
            <span class="journey-count">0{i + 1} / {tour.data.kind}</span>
            <div class="journey-info">
              <span>{tour.data.place} · {tour.data.days}</span>
              <h3>{tour.data.title}</h3>
              <p>{tour.data.summary}</p>
              <b>Descubrir experiencia <i>↗</i></b>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- BELT DE IMÁGENES CONTINUO -->
    <section class="image-belt" aria-label="Galería de rutas andinas" data-reveal>
      <div class="image-belt__track">
        {imageLoop.map((image, index) => (
          <figure class="image-belt__item">
            <img src={image} alt={`Vista sagrada andina ${index + 1}`} loading="lazy" width="1200" height="800" />
          </figure>
        ))}
      </div>
    </section>

    <!-- COMPONENTE WOW: SPIRITUAL QUIZ ("ENCUENTRA TU LLAMADO ANDINO") -->
    <SpiritualQuiz />

    <!-- TRES FORMAS DE RECORRER -->
    <section class="pathways" data-reveal>
      <div class="pathways-copy">
        <div class="section-label section-label--light"><span>03</span> TRES PUERTAS DE ACCESO</div>
        <h2>Un viaje.<br />Tres <em>senderos.</em></h2>
        <p>
          Hay experiencias para meditar en quietud, compartir un rito ceremonial de reciprocidad o peregrinar durante días en las alturas. Escucha tu llamado interior.
        </p>
        <a class="button button--gold" href="/ceremonias">Conoce las ceremonias <span>↗</span></a>
      </div>
      <div class="pathway-list">
        <a href="/rutas/ceremonias" data-tilt>
          <span>01</span>
          <div>
            <h3>Ceremonias Andinas</h3>
            <p>Despachos, ofrendas de Ayni y encuentros guiados por maestros locales.</p>
          </div>
          <b>↗</b>
        </a>
        <a href="/rutas/peregrinaciones" data-tilt>
          <span>02</span>
          <div>
            <h3>Peregrinaciones a los Apus</h3>
            <p>Travesías de altura entre lagunas glaciares y cordilleras vivientes.</p>
          </div>
          <b>↗</b>
        </a>
        <a href="/rutas/iniciacion" data-tilt>
          <span>03</span>
          <div>
            <h3>Rutas de Iniciación</h3>
            <p>Karpay y sabiduría milenaria en las comunidades altas Q'ero.</p>
          </div>
          <b>↗</b>
        </a>
      </div>
    </section>

    <!-- PRINCIPIOS Y RESPETO -->
    <section class="values section-wrap" data-reveal>
      <div class="section-heading">
        <div>
          <div class="section-label"><span>04</span> NUESTRA ÉTICA</div>
          <h2>El respeto es la base<br />del <em>viaje sagrado.</em></h2>
        </div>
        <p class="section-lead">
          La espiritualidad andina no es una mercancía ni una atracción. Colaboramos con maestros autorizados, cuidamos los ecosistemas y aseguramos un impacto regenerativo en cada comunidad anfitriona.
        </p>
      </div>
      <div class="value-grid">
        <article data-tilt>
          <span>01 / VÍNCULO</span>
          <h3>Autenticidad</h3>
          <p>Encuentros genuinos sin adaptaciones teatrales para turistas. Tradición viva en su contexto original.</p>
        </article>
        <article data-tilt>
          <span>02 / ESPÍRITU</span>
          <h3>Presencia</h3>
          <p>Tiempo amplio para la respiración consciente, la escucha de los ríos y la integración mental.</p>
        </article>
        <article data-tilt>
          <span>03 / LEGADO</span>
          <h3>Ayni Real</h3>
          <p>Reciprocidad económica y respeto por la autoridad de las familias y maestros que nos reciben.</p>
        </article>
      </div>
    </section>

    <!-- TESTIMONIOS -->
    <section class="comment-showcase" aria-labelledby="comments-title" data-reveal>
      <div class="section-wrap">
        <div class="section-heading">
          <div>
            <div class="section-label"><span>05</span> RESONANCIAS</div>
            <h2 id="comments-title">Palabras desde el <em>corazón.</em></h2>
          </div>
          <p class="section-lead">Voces de viajeros que caminaron con nosotros hacia los santuarios de altura.</p>
        </div>
      </div>
      <div class="comments-marquee" style="margin-top: 36px;">
        <div class="comments-marquee__track">
          {commentsLoop.map((item) => (
            <article class="comment-card" data-tilt>
              <p>“{item.quote}”</p>
              <footer>{item.name}{item.origin ? ` · ${item.origin}` : ''}</footer>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CUADERNO DE VIAJE (BLOG) -->
    <section class="journal section-wrap" data-reveal>
      <div class="section-heading">
        <div>
          <div class="section-label"><span>06</span> DIARIO DEL CAMINO</div>
          <h2>Sabiduría para ir<br /><em>más profundo.</em></h2>
        </div>
        <a class="under-link" href="/diario">Leer el diario <span>↗</span></a>
      </div>
      <div class="journal-grid">
        {posts.slice(0, 2).map((post) => (
          <article class="journal-card" data-tilt>
            <span>{post.data.place} · {new Date(post.data.date).toLocaleDateString('es-PE', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            <h3><a href={`/diario/${post.id}`}>{post.data.title}</a></h3>
            <p>{post.data.excerpt}</p>
            <a class="under-link" href={`/diario/${post.id}`}>Leer artículo <span>↗</span></a>
          </article>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq section-wrap" data-reveal>
      <div>
        <div class="section-label"><span>07</span> CLARIDAD ANTES DE PARTIR</div>
        <h2>Preguntas<br /><em>frecuentes.</em></h2>
        <a class="under-link" href="/contacto" style="margin-top: 20px;">¿Deseas una consulta personal? Escríbenos <span>↗</span></a>
      </div>
      <div class="faq-list">
        {siteFaq.map((item) => (
          <details>
            <summary>{item.q}<span>+</span></summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CIERRE CONCIERGE -->
    <section class="closing contact-band closing--visual">
      <div class="closing-copy" data-reveal>
        <div class="section-label section-label--light">CONCIERGE ESPIRITUAL</div>
        <h2>Tu viaje sagrado comienza<br />con una <em>conversación.</em></h2>
        <p>
          Cada ruta se prepara con dedicación individual. Escríbenos confidencialmente sobre tus fechas estimadas, tu experiencia previa y tu propósito de viaje.
        </p>
        <div style="display: flex; gap: 14px; flex-wrap: wrap; margin-top: 28px;">
          <a class="button button--gold" href={waLink('Hola, deseo coordinar una consulta espiritual y conocer las experiencias de Machupicchu Beyond.')}>
            Hablar con un Guía por WhatsApp <span>↗</span>
          </a>
          <a class="button button--dark" href="/contacto">
            Solicitar Información Concierge <span>✦</span>
          </a>
        </div>
      </div>
      <div class="closing-visual" data-reveal>
        <img class="closing-visual__main" src={reusedJourneyImages[1]} alt="Machu Picchu místico" width="1200" height="900" />
        <img class="closing-visual__small closing-visual__small--one" src={reusedJourneyImages[3]} alt="Laguna sagrada de altura" width="520" height="360" />
        <img class="closing-visual__small closing-visual__small--two" src={reusedJourneyImages[2]} alt="Sendero andino" width="520" height="360" />
      </div>
      <span class="closing-mark">M</span>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<script is:inline>
  (() => {
    const initIntentWidget = () => {
      const pills = document.querySelectorAll('.intent-pill');
      const titleEl = document.getElementById('preview-tour-title');
      const descEl = document.getElementById('preview-tour-desc');
      const linkEl = document.getElementById('preview-tour-link');

      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          pills.forEach((p) => p.classList.remove('is-selected'));
          pill.classList.add('is-selected');

          const tourTitle = pill.getAttribute('data-tour-title');
          const tourSlug = pill.getAttribute('data-tour-slug');
          const tourDesc = pill.getAttribute('data-tour-desc');

          if (titleEl && tourTitle) titleEl.textContent = tourTitle;
          if (descEl && tourDesc) descEl.textContent = tourDesc;
          if (linkEl && tourSlug) linkEl.href = `/rutas/${tourSlug}`;
        });
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initIntentWidget, { once: true });
    } else {
      initIntentWidget();
    }
    document.addEventListener('astro:page-load', initIntentWidget);
  })();
</script>
