---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site, siteFaq, trustPoints, testimonials, waLink, featuredNumbers, reusedJourneyImages } from '../data/site';
const tours = (await getCollection('tours')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const imageLoop = [...reusedJourneyImages, ...reusedJourneyImages];
const commentsLoop = [...testimonials, ...testimonials];
---

<BaseLayout title="Machupicchu Beyond | Rutas que van más allá" description={site.description}>
  <SiteHeader />

  <main id="main-content">
    <section class="hero hero--immersive" aria-labelledby="hero-title">
      <img class="hero-backdrop" src="/images/journeys/machu-picchu-mist.jpg" alt="Machu Picchu entre la niebla de los Andes" width="2200" height="1467" fetchpriority="high" />
      <div class="hero-overlay"></div>
      <div class="hero-inner">
        <p class="eyebrow">CUSCO · PERÚ <span>—</span> VIAJES CON SENTIDO</p>
        <h1 id="hero-title">El camino<br />te lleva <em>más allá.</em></h1>
        <p class="hero-description">Explora santuarios andinos, caminos de montaña y encuentros culturales desde una mirada cercana, actual y respetuosa.</p>
        <div class="hero-actions">
          <a class="button button--gold" href="/rutas">Explorar las rutas <span>↗</span></a>
          <a class="hero-secondary" href="/nosotros">Conoce nuestra mirada</a>
        </div>
        <div class="hero-floaters" aria-hidden="true">
          <article class="floating-note" data-tilt>
            <span>06 experiencias</span>
            <b>Rutas activas</b>
            <p>Peregrinaciones, ceremonias y viajes de iniciación.</p>
          </article>
          <article class="floating-note floating-note--gold" data-tilt>
            <span>GRUPOS PEQUEÑOS</span>
            <b>4 a 8 viajeros</b>
            <p>Más espacio para la conversación, el silencio y el territorio.</p>
          </article>
        </div>
      </div>
      <p class="hero-caption">MACHU PICCHU · CUSCO <span>FOTOGRAFÍA: GERRY SHEA / UNSPLASH</span></p>
      <span class="hero-index">01 / 06</span>
    </section>
    <div class="marquee"><span>TIERRA · MEMORIA · CAMINO · DESCUBRIMIENTO · TIERRA · MEMORIA · CAMINO · DESCUBRIMIENTO ·</span></div>

    <section class="section-wrap numbers-band" data-reveal>
      {featuredNumbers.map((item) => (
        <article>
          <b>{item.value}</b>
          <span>{item.label}</span>
        </article>
      ))}
    </section>

    <section class="intro section-wrap" id="esencia" data-reveal>
      <div class="section-label"><span>01</span> UNA INVITACIÓN A EXPLORAR</div>
      <div class="intro-grid">
        <h2>No venimos solo a mirar.<br /><em>Venimos a encontrarnos.</em></h2>
        <div>
          <p>Desde Cusco, diseñamos viajes que conectan el territorio andino con una forma más consciente de explorar. Cada ruta tiene su propio ritmo, paisaje y propósito.</p>
          <a class="under-link" href="/nosotros">Nuestra forma de viajar <span>↗</span></a>
        </div>
      </div>
    </section>

    <section class="journeys section-wrap" id="rutas">
      <div class="section-heading" data-reveal>
        <div>
          <div class="section-label"><span>02</span> EXPERIENCIAS</div>
          <h2>Elige tu <em>camino.</em></h2>
        </div>
        <a class="under-link" href="/rutas">Ver todas las rutas <span>↗</span></a>
      </div>
      <div class="journey-grid journey-grid--dynamic">
        {tours.slice(0, 4).map((tour, i) => (
          <a class:list={["journey-card", `journey-card--${i + 1}`]} href={`/rutas/${tour.id}`} data-reveal data-tilt>
            {tour.data.image && <img src={tour.data.image} alt={tour.data.imageAlt || tour.data.title} loading="lazy" width="1200" height="800" />}
            <span class="journey-count">0{i + 1} / {tour.data.kind}</span>
            <div class="journey-info">
              <span>{tour.data.place} · {tour.data.days}</span>
              <h3>{tour.data.title}</h3>
              <p>{tour.data.summary}</p>
              <b>Descubrir ruta <i>↗</i></b>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="image-belt" aria-label="Galería de rutas destacadas" data-reveal>
      <div class="image-belt__track">
        {imageLoop.map((image, index) => (
          <figure class="image-belt__item">
            <img src={image} alt={`Vista andina ${index + 1}`} loading="lazy" width="1200" height="800" />
          </figure>
        ))}
      </div>
    </section>

    <section class="pathways" data-reveal>
      <div class="pathways-copy">
        <div class="section-label section-label--light"><span>03</span> TRES FORMAS DE RECORRER</div>
        <h2>Un viaje.<br />Muchas <em>puertas.</em></h2>
        <p>Hay rutas para caminar en silencio, compartir una ceremonia o iniciar una travesía de varios días. Encuentra la experiencia que resuena contigo.</p>
        <a class="button button--gold" href="/ceremonias">Conoce las experiencias <span>↗</span></a>
      </div>
      <div class="pathway-list">
        <a href="/rutas/ceremonias" data-tilt><span>01</span><div><h3>Ceremonias</h3><p>Espacios de encuentro guiados por facilitadores locales.</p></div><b>↗</b></a>
        <a href="/rutas/peregrinaciones" data-tilt><span>02</span><div><h3>Peregrinaciones</h3><p>Caminar el paisaje altoandino con tiempo y atención.</p></div><b>↗</b></a>
        <a href="/rutas/iniciacion" data-tilt><span>03</span><div><h3>Rutas de iniciación</h3><p>Una primera aproximación a territorios de profunda memoria.</p></div><b>↗</b></a>
      </div>
    </section>

    <section class="values section-wrap" data-reveal>
      <div class="section-heading">
        <div>
          <div class="section-label"><span>04</span> NUESTRA MIRADA</div>
          <h2>El respeto también<br />es parte del <em>viaje.</em></h2>
        </div>
        <p class="section-lead">El territorio no es un escenario. Nos acercamos con humildad, curiosidad y cuidado por quienes lo habitan.</p>
      </div>
      <div class="value-grid">
        <article data-tilt><span>01 / VÍNCULO</span><h3>Autenticidad</h3><p>Conexión con la cultura, la historia y el territorio andino.</p></article>
        <article data-tilt><span>02 / CAMINO</span><h3>Aventura</h3><p>Rutas que invitan a explorar con presencia y apertura.</p></article>
        <article data-tilt><span>03 / LEGADO</span><h3>Herencia</h3><p>Respeto por las tradiciones y las comunidades locales.</p></article>
      </div>
    </section>

    <section class="trust section-wrap" aria-labelledby="trust-title" data-reveal>
      <div class="section-heading">
        <div>
          <div class="section-label"><span>05</span> VIAJAR CON CONFIANZA</div>
          <h2 id="trust-title">Cuidado antes,<br />durante y <em>después.</em></h2>
        </div>
        <p class="section-lead">Una experiencia significativa también necesita logística clara, grupos manejables y acompañamiento local.</p>
      </div>
      <div class="value-grid">
        {trustPoints.map((item, i) => <article data-tilt><span>0{i + 1} / CONFIANZA</span><h3>{item.title}</h3><p>{item.text}</p></article>)}
      </div>
    </section>

    <section class="comment-showcase" aria-labelledby="comments-title" data-reveal>
      <div class="section-wrap comment-showcase__inner">
        <div class="section-heading comment-showcase__head">
          <div>
            <div class="section-label"><span>06</span> COMENTARIOS</div>
            <h2 id="comments-title">Así se siente<br /><em>el viaje.</em></h2>
          </div>
          <p class="section-lead">Puedes reemplazar estos comentarios con testimonios reales cuando tengas el material definitivo.</p>
        </div>
      </div>
      <div class="comments-marquee">
        <div class="comments-marquee__track">
          {commentsLoop.map((item, index) => (
            <article class="comment-card" data-tilt>
              <p>“{item.quote}”</p>
              <footer>{item.name}{item.origin ? ` · ${item.origin}` : ''}</footer>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="journal section-wrap" data-reveal>
      <div class="section-heading">
        <div>
          <div class="section-label"><span>07</span> CUADERNO DE VIAJE</div>
          <h2>Ideas para ir<br /><em>más profundo.</em></h2>
        </div>
        <a class="under-link" href="/diario">Leer el diario <span>↗</span></a>
      </div>
      <div class="journal-grid">
        {posts.slice(0, 2).map((post) => <article class="journal-card" data-tilt><span>{post.data.place} · {new Date(post.data.date).toLocaleDateString('es-PE', { year: 'numeric', month: 'long', day: 'numeric' })}</span><h3><a href={`/diario/${post.id}`}>{post.data.title}</a></h3><p>{post.data.excerpt}</p><a class="under-link" href={`/diario/${post.id}`}>Leer artículo <span>↗</span></a></article>)}
      </div>
    </section>

    <section class="faq section-wrap" data-reveal>
      <div>
        <div class="section-label"><span>08</span> ANTES DE PARTIR</div>
        <h2>Preguntas<br /><em>frecuentes.</em></h2>
        <a class="under-link" href="/contacto">¿Tienes otra pregunta? Escríbenos <span>↗</span></a>
      </div>
      <div class="faq-list">{siteFaq.map((item) => <details><summary>{item.q}<span>+</span></summary><p>{item.a}</p></details>)}</div>
    </section>

    <section class="closing contact-band closing--visual">
      <div class="closing-copy" data-reveal>
        <div class="section-label section-label--light">EL SIGUIENTE PASO</div>
        <h2>Tu ruta comienza<br />con una <em>conversación.</em></h2>
        <p>Cuéntanos qué te gustaría explorar. Te ayudamos a encontrar la experiencia adecuada y la mejor ruta según tu tiempo y tu intención.</p>
        <a class="button button--gold" href={waLink('Hola, quisiera información sobre las experiencias de Machupicchu Beyond.')}>Conversemos por WhatsApp <span>↗</span></a>
      </div>
      <div class="closing-visual" data-reveal>
        <img class="closing-visual__main" src={reusedJourneyImages[1]} alt="Paisaje andino referencial" width="1200" height="900" />
        <img class="closing-visual__small closing-visual__small--one" src={reusedJourneyImages[3]} alt="Paisaje referencial" width="520" height="360" />
        <img class="closing-visual__small closing-visual__small--two" src={reusedJourneyImages[2]} alt="Ruta andina referencial" width="520" height="360" />
      </div>
      <span class="closing-mark">M</span>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
