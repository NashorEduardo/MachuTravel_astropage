---
// Redirección raíz estática con detección inteligente de idioma
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content="0;url=/es/" />
    <link rel="canonical" href="https://machupicchubeyond.com/es/" />
    <title>Machupicchu Beyond — Redirigiendo...</title>
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('mb_lang');
          const browser = (navigator.language || navigator.userLanguage || '').slice(0, 2).toLowerCase();
          const target = saved && ['es', 'en', 'pt'].includes(saved)
            ? saved
            : ['es', 'en', 'pt'].includes(browser)
              ? browser
              : 'es';
          window.location.replace('/' + target + '/');
        } catch (e) {
          window.location.replace('/es/');
        }
      })();
    </script>
  </head>
  <body style="font-family: sans-serif; background: #0e0f0a; color: #f8f5ee; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0;">
    <div style="text-align: center; padding: 20px;">
      <h1 style="font-size: 20px; font-weight: 500; letter-spacing: 0.08em;">MACHUPICCHU BEYOND</h1>
      <p style="color: #9ea094; font-size: 14px; margin-top: 8px;">
        Redirigiendo a tu experiencia... / Redirecting to your experience...
      </p>
      <p style="margin-top: 16px;">
        <a href="/es/" style="color: #ffca02; text-decoration: none; margin: 0 10px;">Español</a>
        <a href="/en/" style="color: #ffca02; text-decoration: none; margin: 0 10px;">English</a>
        <a href="/pt/" style="color: #ffca02; text-decoration: none; margin: 0 10px;">Português</a>
      </p>
    </div>
  </body>
</html>
