---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TourCatalog from '../../components/TourCatalog.astro';
import SacredTimeline from '../../components/SacredTimeline.astro';
import { absoluteUrl, site, waLink, testimonials } from '../../data/site';

export async function getStaticPaths() {
  return (await getCollection('tours')).map((tour) => ({
    params: { slug: tour.id },
    props: { tour },
  }));
}

const allTours = (await getCollection('tours')).sort((a, b) => a.data.order - b.data.order);
const { tour } = Astro.props;
const { Content } = await render(tour);
const tourUrl = absoluteUrl(`/rutas/${tour.id}`);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: tour.data.title,
  description: tour.data.summary,
  url: tourUrl,
  touristType: tour.data.kind,
  provider: { '@type': 'TravelAgency', name: site.name, url: site.url },
  ...(tour.data.image ? { image: absoluteUrl(tour.data.image) } : {}),
};

const faqSchema = tour.data.faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: tour.data.faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    }
  : undefined;

const rawGallery = [tour.data.image, ...tour.data.gallery].filter(Boolean) as string[];
const galleryImages = rawGallery.length
  ? Array.from({ length: Math.max(4, rawGallery.length) }, (_, index) => rawGallery[index % rawGallery.length])
  : [];

const relatedTours = allTours
  .filter((item) => item.id !== tour.id)
  .sort((a, b) => Number(b.data.kind === tour.data.kind) - Number(a.data.kind === tour.data.kind))
  .slice(0, 3);

const experiencePoints = [
  { label: 'Propósito Sagrado', value: tour.data.subtitle },
  { label: 'Territorio Andino', value: tour.data.place },
  { label: 'Linaje & Estilo', value: tour.data.tag },
];

const highlightCards = tour.data.includes.slice(0, 3).map((item) => ({
  title: item,
  text: 'Cuidado logístico y energético garantizado para esta experiencia sagrada.',
}));

const comments = testimonials.length ? testimonials : [
  {
    quote: 'Una vivencia transformadora que honra la tradición viva de los Andes con respeto absoluto.',
    name: 'Viajero Consciente',
    origin: 'Cusco',
  },
];

const waMessage = `Hola, deseo consultar fechas y solicitar mi espacio para la experiencia sagrada: "${tour.data.title}" en Machupicchu Beyond.`;
---

<BaseLayout
  title={`${tour.data.title} | Machupicchu Beyond`}
  description={tour.data.summary}
  image={tour.data.image || site.defaultImage}
  schema={faqSchema ? [schema, faqSchema] : schema}
>
  <SiteHeader />

  <main id="main-content">
    <div class="breadcrumb-wrap">
      <Breadcrumbs
        items={[
          { label: 'Inicio', href: '/' },
          { label: 'Rutas', href: '/rutas' },
          { label: tour.data.title },
        ]}
      />
    </div>

    <!-- HERO CINEMATOGRÁFICO DE LA RUTA -->
    <section class="detail-hero detail-hero--layered">
      {tour.data.image && (
        <img
          src={tour.data.image}
          alt={tour.data.imageAlt || tour.data.title}
          width="1800"
          height="1100"
          fetchpriority="high"
        />
      )}
      <div>
        <p class="section-label section-label--light">
          <span>✦</span> {tour.data.kind} · {tour.data.place}
        </p>
        <h1>{tour.data.title}</h1>
        <p>{tour.data.summary}</p>
        
        <div class="detail-hero__actions">
          <a class="button button--gold" href={waLink(waMessage)} target="_blank" rel="noopener noreferrer">
            Hablar con un Guía Espiritual <span>💬</span>
          </a>
          <a class="button button--dark" href="#timeline-heading">
            Ver Itinerario Vivencial <span>↓</span>
          </a>
          <a class="hero-secondary hero-secondary--light" href="#otras-rutas">
            Otras rutas sagradas
          </a>
        </div>
      </div>

      <aside class="detail-side-card" data-tilt>
        <span>EXPERIENCIA SACRA</span>
        <b>{tour.data.days}</b>
        <p>{tour.data.group}</p>
        <small>{tour.data.level}</small>
      </aside>
    </section>

    {tour.data.referentialImage && (
      <p class="image-note" style="text-align: center; font-size: 10px; color: #828073; margin-top: 8px;">
        Fotografía referencial del paisaje andino; seleccionada para transmitir la atmósfera del territorio.
      </p>
    )}

    <!-- BANDA DE DATOS CLAVE -->
    <section class="detail-facts">
      <div><span>DURACIÓN</span><b>{tour.data.days}</b></div>
      <div><span>GRUPO ÍNTIMO</span><b>{tour.data.group}</b></div>
      <div><span>NIVEL & EXIGENCIA</span><b>{tour.data.level}</b></div>
      <div><span>MODALIDAD</span><b>Concierge Personalizado</b></div>
    </section>

    <!-- PUNTOS DE FOCO ESPIRITUAL -->
    <section class="section-wrap detail-points" data-reveal>
      <div class="detail-points__grid">
        {experiencePoints.map((point) => (
          <article data-tilt>
            <span>{point.label}</span>
            <h3>{point.value}</h3>
          </article>
        ))}
      </div>
    </section>

    <!-- CONTENIDO PRINCIPAL EN 2 COLUMNAS (LAYOUT EDITORIAL + STICKY CONCIERGE CARD) -->
    <div class="section-wrap" style="margin-top: 50px;">
      <div class="tour-detail-layout">
        <!-- COLUMNA PRINCIPAL -->
        <div class="tour-main-content">
          <!-- COMPONENTE WOW: SACRED TIMELINE (ITINERARIO MÍSTICO VERTICAL) -->
          <SacredTimeline
            itinerary={tour.data.itinerary}
            tourKind={tour.data.kind}
            place={tour.data.place}
            tourTitle={tour.data.title}
          />

          <!-- GALERÍA MOSAICO -->
          {galleryImages.length > 0 && (
            <section class="tour-gallery" aria-labelledby="gallery-title" data-reveal>
              <div class="section-heading">
                <div>
                  <p class="section-label"><span>✦</span> PAISAJES DEL SENDERO</p>
                  <h2 id="gallery-title">Una mirada al <em>territorio.</em></h2>
                </div>
                <p class="section-lead">Imágenes que anticipan la serenidad y la inmensidad que te recibirán en el camino.</p>
              </div>
              <div class="gallery-grid gallery-grid--mosaic">
                {galleryImages.map((image, index) => (
                  <a href={image} target="_blank" rel="noopener noreferrer" class:list={[index === 0 ? 'gallery-grid__feature' : '']}>
                    <img
                      src={image}
                      alt={`${tour.data.title}, fotografía ${index + 1}`}
                      loading="lazy"
                      width="1200"
                      height="800"
                    />
                  </a>
                ))}
              </div>
            </section>
          )}

          <!-- QUÉ HACE ESPECIAL A ESTA RUTA -->
          <section class="tour-highlights" data-reveal style="margin-top: 60px;">
            <div>
              <p class="section-label"><span>✦</span> ELEMENTOS DE VALOR</p>
              <h2 style="font-size: clamp(32px, 4vw, 48px);">Sentido y <em>cuidado.</em></h2>
            </div>
            <div class="tour-highlights__grid">
              {highlightCards.map((item) => (
                <article data-tilt>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </article>
              ))}
            </div>
          </section>

          <!-- INCLUYE / NO INCLUYE -->
          <div class="included-grid" data-reveal style="margin-top: 60px;">
            <div>
              <h3 style="font-size: 20px; font-weight: 700; color: var(--machu); margin-bottom: 18px;">
                ✦ Lo que incluye la experiencia
              </h3>
              <ul style="padding-left: 0; list-style: none;">
                {tour.data.includes.map((item) => (
                  <li style="display: flex; gap: 10px; align-items: flex-start; padding: 8px 0; border-bottom: 1px solid #f0ede4;">
                    <span style="color: var(--inti-deep); font-weight: 700;">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <h3 style="font-size: 20px; font-weight: 700; color: #858273; margin-bottom: 18px;">
                ○ No incluye
              </h3>
              <ul style="padding-left: 0; list-style: none;">
                {tour.data.excludes.map((item) => (
                  <li style="display: flex; gap: 10px; align-items: flex-start; padding: 8px 0; border-bottom: 1px solid #f0ede4; color: #727063;">
                    <span style="color: #b0ab9e;">—</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- RELATO EDITORIAL MARKDOWN -->
          <div class="markdown-content" data-reveal style="margin-top: 60px;">
            <Content />
          </div>

          <!-- COMENTARIOS Y RESONANCIAS -->
          <section class="tour-comments" aria-labelledby="comments-tour-title" data-reveal style="margin-top: 70px;">
            <div class="section-heading">
              <div>
                <p class="section-label"><span>✦</span> RESONANCIAS</p>
                <h2 id="comments-tour-title">Voces del <em>camino.</em></h2>
              </div>
              <p class="section-lead">Lo que otros viajeros han experimentado al recorrer estos santuarios.</p>
            </div>
            <div class="tour-comments__grid">
              {comments.slice(0, 3).map((item) => (
                <article data-tilt>
                  <p>“{item.quote}”</p>
                  <footer>{item.name}{item.origin ? ` · ${item.origin}` : ''}</footer>
                </article>
              ))}
            </div>
          </section>

          <!-- PREGUNTAS FRECUENTES DEL TOUR -->
          {tour.data.faq.length > 0 && (
            <section class="tour-faq-panel" data-reveal style="margin-top: 70px;">
              <div>
                <p class="section-label"><span>✦</span> ACLARACIONES IMPORTANTES</p>
                <h2>Preguntas sobre esta <em>ruta.</em></h2>
              </div>
              <div class="faq-list faq-list--panel">
                {tour.data.faq.map((item) => (
                  <details>
                    <summary>{item.q}<span>+</span></summary>
                    <p>{item.a}</p>
                  </details>
                ))}
              </div>
            </section>
          )}
        </div>

        <!-- COLUMNA LATERAL: STICKY CONCIERGE CARD DE CONVERSIÓN -->
        <aside class="concierge-sidebar">
          <div class="concierge-sticky-card glass-glow-card" data-tilt>
            <span class="concierge-badge">✦ ATENCIÓN CONCIERGE</span>
            <h3>{tour.data.title}</h3>
            <p style="font-size: 12px; color: rgba(255,255,255,0.8); line-height: 1.7; margin: 0 0 16px;">
              {tour.data.subtitle} en el territorio sagrado de {tour.data.place}.
            </p>

            <div class="concierge-specs">
              <div>
                <span>Duración</span>
                <b>{tour.data.days}</b>
              </div>
              <div>
                <span>Tamaño de Grupo</span>
                <b>{tour.data.group}</b>
              </div>
              <div>
                <span>Exigencia</span>
                <b>{tour.data.level}</b>
              </div>
              <div>
                <span>Inversión</span>
                <b>{tour.data.price}</b>
              </div>
            </div>

            <p style="font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--inti); margin-bottom: 10px;">
              ACOMPAÑAMIENTO INTEGRAL:
            </p>
            <ul class="concierge-included-list">
              <li>Facilitador o Paqo local autorizado</li>
              <li>Ofrenda y elementos ceremoniales</li>
              <li>Transporte privado y apoyo logístico</li>
              <li>Entrevista previa y espacio de integración</li>
            </ul>

            <div class="concierge-cta-stack">
              <a
                class="button button--gold"
                href={waLink(waMessage)}
                target="_blank"
                rel="noopener noreferrer"
              >
                Hablar con un Guía Espiritual <span>💬</span>
              </a>
              <a
                class="button button--dark"
                href={`/contacto?ruta=${encodeURIComponent(tour.data.title)}`}
              >
                Solicitar Ceremonia / Reservar Espacio <span>✦</span>
              </a>
            </div>

            <p style="margin: 16px 0 0; text-align: center; font-size: 10px; color: rgba(255,255,255,0.5);">
              Respuesta personalizada desde Cusco en menos de 12 horas.
            </p>
          </div>
        </aside>
      </div>
    </div>

    <!-- BANDA FINAL DE DISPONIBILIDAD -->
    <div class="section-wrap" style="margin-top: 80px;">
      <section class="tour-cta-band" data-reveal>
        <div>
          <p class="section-label section-label--light"><span>✦</span> FECHAS Y CUPOS</p>
          <h2>¿Sientes el llamado a<br /><em>caminar este sendero?</em></h2>
          <p>
            Trabajamos con grupos reducidos para salvaguardar la intimidad de cada experiencia. Consúltanos por las fechas de salida disponibles.
          </p>
        </div>
        <a class="button button--gold" href={waLink(waMessage)} target="_blank" rel="noopener noreferrer">
          Consultar fechas disponibles <span>↗</span>
        </a>
      </section>
    </div>

    <!-- OTRAS RUTAS RECOMENDADAS -->
    <section id="otras-rutas" class="related-tours section-wrap" data-reveal style="margin-top: 100px;">
      <div class="section-heading">
        <div>
          <p class="section-label"><span>✦</span> OTRAS EXPERIENCIAS</p>
          <h2>Caminos complementarios<br /><em>en los Andes.</em></h2>
        </div>
        <a class="under-link" href="/rutas">Ver catálogo completo <span>↗</span></a>
      </div>
      <TourCatalog tours={relatedTours} />
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
