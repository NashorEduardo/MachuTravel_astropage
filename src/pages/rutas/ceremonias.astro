---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TourCatalog from '../../components/TourCatalog.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const KIND = 'ceremonia';
const LABEL = 'Ceremonias Andinas';
const TITLE = 'Encuentros Sagrados';
const tours = (await getCollection('tours')).filter((t) => t.data.kind === KIND).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={`${LABEL} en Cusco y Valle Sagrado | Machupicchu Beyond`}
  description="Ceremonias de Despacho a la Pachamama y retiros de medicina tradicional en Cusco guiados por maestros locales."
>
  <SiteHeader />
  <main id="main-content">
    <section class="page-hero">
      <div class="breadcrumb-wrap" style="padding: 0; margin-bottom: 24px;">
        <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Rutas', href: '/rutas' }, { label: LABEL }]} />
      </div>
      <p class="section-label"><span>✦</span> RITOS DE AYNI Y CONEXIÓN</p>
      <h1>{TITLE}<br /><em>con presencia y respeto.</em></h1>
      <p>
        Espacios sagrados de reciprocidad y ofrenda conducidos por facilitadores y maestros de sabiduría local en parajes protegidos.
      </p>
    </section>

    <section class="catalog section-wrap">
      <nav class="filters" aria-label="Filtrar rutas">
        <a href="/rutas">Todas</a>
        <a class="is-active" href="/rutas/ceremonias">Ceremonias</a>
        <a href="/rutas/peregrinaciones">Peregrinaciones</a>
        <a href="/rutas/iniciacion">Iniciación</a>
      </nav>

      <TourCatalog tours={tours} />
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
