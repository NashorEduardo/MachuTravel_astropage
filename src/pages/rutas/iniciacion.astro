---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TourCatalog from '../../components/TourCatalog.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const KIND = 'iniciacion';
const LABEL = 'Rutas de Iniciación';
const TITLE = 'Iniciación Ancestral';
const tours = (await getCollection('tours')).filter((t) => t.data.kind === KIND).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={`${LABEL} Q'ero y Linaje Inca | Machupicchu Beyond`}
  description="Viajes de iniciación hacia comunidades Q'ero en los Andes altos de Cusco con ritos de paso y convivencia tradicional."
>
  <SiteHeader />
  <main id="main-content">
    <section class="page-hero">
      <div class="breadcrumb-wrap" style="padding: 0; margin-bottom: 24px;">
        <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Rutas', href: '/rutas' }, { label: LABEL }]} />
      </div>
      <p class="section-label"><span>✦</span> LINAJE SAGRADO Y MEMORIA</p>
      <h1>{TITLE}<br /><em>y ritos de paso.</em></h1>
      <p>
        Aproximación respetuosa a las comunidades de altura de los Q'ero, guardianes de la cosmovisión inca y transmisores de ritos Karpay.
      </p>
    </section>

    <section class="catalog section-wrap">
      <nav class="filters" aria-label="Filtrar rutas">
        <a href="/rutas">Todas</a>
        <a href="/rutas/ceremonias">Ceremonias</a>
        <a href="/rutas/peregrinaciones">Peregrinaciones</a>
        <a class="is-active" href="/rutas/iniciacion">Iniciación</a>
      </nav>

      <TourCatalog tours={tours} />
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
