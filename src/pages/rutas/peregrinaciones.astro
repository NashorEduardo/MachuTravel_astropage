---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TourCatalog from '../../components/TourCatalog.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const KIND = 'peregrinacion';
const LABEL = 'Peregrinaciones a los Apus';
const TITLE = 'Senderos Sagrados';
const tours = (await getCollection('tours')).filter((t) => t.data.kind === KIND).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={`${LABEL} | Machupicchu Beyond`}
  description="Peregrinaciones de altura hacia el Apu Ausangate, Waqrapukara y Machu Picchu al amanecer con grupos reducidos."
>
  <SiteHeader />
  <main id="main-content">
    <section class="page-hero">
      <div class="breadcrumb-wrap" style="padding: 0; margin-bottom: 24px;">
        <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Rutas', href: '/rutas' }, { label: LABEL }]} />
      </div>
      <p class="section-label"><span>✦</span> MONTAÑAS SAGRADAS Y SILENCIO</p>
      <h1>{TITLE}<br /><em>hacia el silencio andino.</em></h1>
      <p>
        Caminar la alta montaña con respeto y presencia: pasos glaciares, lagunas sagradas y santuarios remotos.
      </p>
    </section>

    <section class="catalog section-wrap">
      <nav class="filters" aria-label="Filtrar rutas">
        <a href="/rutas">Todas</a>
        <a href="/rutas/ceremonias">Ceremonias</a>
        <a class="is-active" href="/rutas/peregrinaciones">Peregrinaciones</a>
        <a href="/rutas/iniciacion">Iniciación</a>
      </nav>

      <TourCatalog tours={tours} />
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
